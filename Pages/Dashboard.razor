@page "/dashboard"
@using SmartStudyHub.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="min-h-screen flex flex-col bg-[#f8f9fc] font-sans antialiased text-gray-800">
    <!-- Top Navigation Bar -->
    <header class="w-full bg-white border-b border-gray-100 py-3.5 px-8 flex items-center justify-between">
        <!-- Clickable Brand Logo & Name -->
        <a href="/" class="flex items-center gap-2.5 hover:opacity-80 transition-opacity">
            <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold text-sm">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                </svg>
            </div>
            <span class="font-bold text-gray-900 text-sm tracking-tight">Smart Study Hub</span>
        </a>

        <div class="flex items-center gap-2 text-xs text-gray-500">
            <button @onclick="HandleSignOut" class="hover:text-gray-800 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                Sign out
            </button>
        </div>
    </header>

    <!-- Subtitle Greeting -->
    <div class="max-w-5xl w-full mx-auto px-6 pt-6 pb-2">
        <p class="text-xs text-gray-400">Good afternoon — ready to focus?</p>
    </div>

    <!-- Dashboard Grid Cards -->
    <main class="max-w-5xl w-full mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-6 pb-12">
        
        <!-- Document Summarizer Card -->
        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-[0_2px_10px_rgba(0,0,0,0.02)] flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                        <h2 class="font-bold text-gray-900 text-xs">Document Summarizer</h2>
                    </div>
                    <span class="text-[10px] bg-blue-50 text-blue-600 px-2 py-0.5 rounded-full font-medium">AI</span>
                </div>

                <!-- Hidden Native Input / Custom Drop Zone -->
                <div class="relative border-2 border-dashed @(isHovering ? "border-blue-400 bg-blue-50/50" : "border-gray-100 bg-gray-50/30") rounded-xl p-6 text-center mb-4 hover:bg-gray-50/80 transition-colors cursor-pointer">
                    
                    <InputFile OnChange="HandleFileSelected" 
                               accept=".pdf,.docx,.txt"
                               class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" 
                               @ondragenter="() => isHovering = true"
                               @onmouseleave="() => isHovering = false" />

                    @if (isProcessing)
                    {
                        <!-- Loading State -->
                        <div class="flex flex-col items-center justify-center py-2">
                            <div class="w-6 h-6 border-2 border-blue-600 border-t-transparent rounded-full animate-spin mb-2"></div>
                            <p class="text-xs font-semibold text-gray-700">Summarizing "@uploadedFileName"...</p>
                            <p class="text-[10px] text-gray-400 mt-0.5">Extracting key concepts using AI</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(uploadedFileName))
                    {
                        <!-- File Uploaded State -->
                        <div class="flex items-center justify-center gap-2 mb-1">
                            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span class="text-xs font-semibold text-gray-800 truncate max-w-[200px]">@uploadedFileName</span>
                        </div>
                        <p class="text-[10px] text-blue-600 font-medium">Click or drop another file to replace</p>
                    }
                    else
                    {
                        <!-- Initial Default State -->
                        <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center mx-auto mb-2 text-blue-600">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                        </div>
                        <p class="text-xs font-semibold text-gray-700">Drop your file here</p>
                        <p class="text-[10px] text-gray-400 mt-0.5">PDF, DOCX, TXT — up to 20 MB</p>
                    }
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-4 p-2.5 bg-red-50 border border-red-200 text-red-600 text-[11px] rounded-lg">
                        @errorMessage
                    </div>
                }

                <!-- Summary Box -->
                <div class="bg-gray-50/50 rounded-xl p-3.5 border border-gray-100">
                    <div class="flex items-center justify-between mb-1.5">
                        <div class="flex items-center gap-1.5">
                            <div class="w-1.5 h-1.5 @(isProcessing ? "bg-amber-400 animate-pulse" : "bg-emerald-500") rounded-full"></div>
                            <span class="text-[10px] font-bold tracking-wider text-gray-500 uppercase">Summary</span>
                        </div>
                        @if (!string.IsNullOrEmpty(uploadedFileName) && !isProcessing)
                        {
                            <span class="text-[9px] text-gray-400 font-mono">@(summaryText.Length) chars</span>
                        }
                    </div>
                    <p class="text-[11px] leading-relaxed text-gray-500 min-h-[80px]">
                        @summaryText
                    </p>
                </div>
            </div>
        </div>

        <!-- Flashcards Card -->
        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-[0_2px_10px_rgba(0,0,0,0.02)] flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                        <h2 class="font-bold text-gray-900 text-xs">Flashcards</h2>
                    </div>
                    <span class="text-[10px] text-blue-600 font-medium bg-blue-50 px-2 py-0.5 rounded-full">1 / 4</span>
                </div>

                <div class="bg-gradient-to-b from-blue-50/40 to-blue-50/10 border border-blue-100/60 rounded-xl p-8 text-center flex flex-col items-center justify-center min-h-[160px] mb-6">
                    <span class="text-[9px] font-bold uppercase tracking-wider text-blue-400 mb-2">Question</span>
                    <p class="font-semibold text-gray-800 text-sm">What is the spacing effect?</p>
                </div>
            </div>

            <div class="flex items-center justify-between">
                <button class="text-xs text-gray-400 hover:text-gray-600 flex items-center gap-1 font-medium">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                    Prev
                </button>
                <button class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-medium flex items-center gap-1.5 shadow-sm transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                    Flip Card
                </button>
                <button class="text-xs text-gray-400 hover:text-gray-600 flex items-center gap-1 font-medium">
                    Next
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
            </div>
        </div>

        <!-- Focus Music Card -->
        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-[0_2px_10px_rgba(0,0,0,0.02)] flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-2 mb-4">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-2v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-2c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-2" /></svg>
                    <h2 class="font-bold text-gray-900 text-xs">Focus Music</h2>
                </div>

                <div class="relative mb-4">
                    <select class="w-full bg-gray-50/50 border border-gray-100 rounded-xl px-3.5 py-2.5 text-xs text-gray-700 font-medium appearance-none focus:outline-none cursor-pointer">
                        <option>Soft Rain</option>
                        <option>Lo-Fi Beats</option>
                        <option>Forest Ambience</option>
                    </select>
                    <div class="absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </div>
                </div>

                <div class="bg-gray-50/50 rounded-xl py-6 flex items-center justify-center gap-1.5 mb-4 border border-gray-100">
                    <div class="w-1 bg-gray-200 h-3 rounded-full"></div>
                    <div class="w-1 bg-gray-200 h-5 rounded-full"></div>
                    <div class="w-1 bg-gray-300 h-8 rounded-full"></div>
                    <div class="w-1 bg-gray-200 h-4 rounded-full"></div>
                    <div class="w-1 bg-gray-200 h-6 rounded-full"></div>
                </div>
            </div>

            <div>
                <button class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-medium flex items-center justify-center gap-2 shadow-sm transition-colors mb-2">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                    Play
                </button>
                <p class="text-[10px] text-gray-400 text-center">Select a sound and hit play</p>
            </div>
        </div>

        <!-- Quick Scratchpad Card -->
        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-[0_2px_10px_rgba(0,0,0,0.02)] flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-2 mb-4">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                    <h2 class="font-bold text-gray-900 text-xs">Quick Scratchpad</h2>
                </div>

                <textarea class="w-full bg-gray-50/50 border border-gray-100 rounded-xl p-3.5 text-xs text-gray-700 placeholder-gray-300 focus:outline-none focus:bg-white resize-none h-32" placeholder="Jot down ideas, formulas, or reminders..."></textarea>
            </div>

            <div class="flex items-center justify-between mt-4">
                <span class="text-[10px] text-gray-300">Not saved yet</span>
                <button class="px-4 py-2 bg-gray-100 text-gray-400 rounded-xl text-xs font-medium cursor-not-allowed">
                    Save Notes
                </button>
            </div>
        </div>

    </main>

    <footer class="mt-auto py-6 text-center text-[10px] text-gray-400">
        Smart Study Hub - Built for focused learners
    </footer>
</div>

@code {
    private string? uploadedFileName;
    private string summaryText = "This document covers three core principles of spaced repetition: (1) optimal review intervals increase retention by 40-60%, (2) active recall outperforms passive re-reading, and (3) interleaving subjects reduces cognitive fatigue. Key takeaway: study in focused 25-min blocks with deliberate rest.";
    private bool isProcessing = false;
    private bool isHovering = false;
    private string? errorMessage;

    private const long MaxFileSize = 20 * 1024 * 1024; // 20 MB limit

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var file = e.File;

        if (file == null) return;

        if (file.Size > MaxFileSize)
        {
            errorMessage = "File size exceeds the 20 MB limit. Please choose a smaller document.";
            return;
        }

        var allowedExtensions = new[] { ".pdf", ".docx", ".txt" };
        var extension = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowedExtensions.Contains(extension))
        {
            errorMessage = "Unsupported file format. Please upload a PDF, DOCX, or TXT file.";
            return;
        }

        uploadedFileName = file.Name;
        isProcessing = true;
        StateHasChanged();

        try
        {
            if (extension == ".txt")
            {
                using var stream = file.OpenReadStream(MaxFileSize);
                using var reader = new System.IO.StreamReader(stream);
                var content = await reader.ReadToEndAsync();
                
                await Task.Delay(1000); // Simulate processing time
                summaryText = GenerateSummaryFromText(content, file.Name);
            }
            else
            {
                // Simulate AI summarization processing for PDF / DOCX
                await Task.Delay(1800);
                summaryText = $"Summary for '{file.Name}': (1) Key concepts extracted automatically across sections, (2) Core conclusions highlighting main theoretical frameworks, and (3) Practical takeaways for quick revision and active testing.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error reading file: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private string GenerateSummaryFromText(string text, string filename)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return $"The uploaded file '{filename}' appears to be empty.";
        }

        var lines = text.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        var previewText = string.Join(" ", lines.Take(5));

        if (previewText.Length > 220)
        {
            previewText = previewText.Substring(0, 220) + "...";
        }

        return $"Summary for '{filename}': {previewText}";
    }

    private void HandleSignOut()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}