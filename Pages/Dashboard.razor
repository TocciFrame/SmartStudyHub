@page "/dashboard"

<div class="min-h-screen bg-slate-100/60 p-6 font-sans text-slate-800 flex flex-col justify-between">
    <div>
        <!-- Top Workspace Header -->
        <header class="max-w-5xl mx-auto flex items-center justify-between mb-8">
            <div class="flex items-center gap-3">
                <div class="bg-blue-600 text-white p-2 rounded-xl shadow-sm">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4 4h4v4H4V4zm6 0h4v4h-4V4zm6 0h4v4h-4V4zM4 10h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4zM4 16h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-base font-bold text-slate-900 leading-tight">Smart Study Hub</h1>
                    <p class="text-[11px] text-slate-400">Good afternoon — ready to focus?</p>
                </div>
            </div>
            <a href="/" class="text-xs text-slate-400 hover:text-slate-600 flex items-center gap-1 font-medium">
                ‹ Sign out
            </a>
        </header>

        <!-- 2x2 Workspace Grid -->
        <main class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-5">

            <!-- Card 1: Document Summarizer -->
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col justify-between min-h-[300px]">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2 font-bold text-slate-800 text-xs">
                            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            <span>Document Summarizer</span>
                        </div>
                        <span class="bg-blue-50 text-blue-600 text-[10px] font-semibold px-1.5 py-0.5 rounded">AI</span>
                    </div>

                    <!-- Drop Zone -->
                    <div class="border border-dashed border-blue-200 rounded-xl p-5 text-center bg-blue-50/20 hover:bg-blue-50/40 cursor-pointer mb-3 transition-colors">
                        <div class="inline-flex items-center justify-center w-8 h-8 bg-blue-50 text-blue-500 rounded-lg mb-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                            </svg>
                        </div>
                        <p class="font-bold text-slate-700 text-xs">Drop your file here</p>
                        <p class="text-[10px] text-slate-400 mt-0.5">PDF, DOCX, TXT — up to 20 MB</p>
                    </div>

                    <!-- Summary Box -->
                    <div class="bg-slate-50/80 p-3 rounded-xl text-[11px] text-slate-400 space-y-1.5 leading-relaxed border border-slate-100">
                        <div class="flex items-center gap-1 font-semibold text-emerald-600 text-[9px] uppercase tracking-wider">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> SUMMARY
                        </div>
                        <p class="text-slate-400">This document covers three core principles of spaced repetition: (1) optimal review intervals increase retention by 40–60%, (2) active recall outperforms passive re-reading, and (3) interleaving subjects reduces cognitive fatigue. Key takeaway: study in focused 25-min blocks with deliberate rest.</p>
                    </div>
                </div>
            </div>

            <!-- Card 2: Flashcards -->
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col justify-between min-h-[300px]">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2 font-bold text-slate-800 text-xs">
                            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                            </svg>
                            <span>Flashcards</span>
                        </div>
                        <span class="bg-blue-50 text-blue-600 text-[10px] font-semibold px-2 py-0.5 rounded-full">1 / 4</span>
                    </div>

                    <!-- Card Body -->
                    <div class="bg-blue-50/60 rounded-xl p-6 flex flex-col items-center justify-center text-center my-3 border border-blue-100/50 min-h-[140px]">
                        <span class="text-[9px] font-bold text-blue-400 tracking-wider uppercase mb-2">QUESTION</span>
                        <p class="text-xs font-bold text-blue-900">What is the spacing effect?</p>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-1 text-xs">
                    <button class="text-slate-500 hover:text-slate-800 font-medium text-[11px] flex items-center gap-1">‹ Prev</button>
                    <button class="bg-blue-600 hover:bg-blue-700 text-white text-[11px] font-semibold px-4 py-1.5 rounded-lg shadow-2xs flex items-center gap-1.5">
                        🔄 Flip Card
                    </button>
                    <button class="text-slate-500 hover:text-slate-800 font-medium text-[11px] flex items-center gap-1">Next ›</button>
                </div>
            </div>

            <!-- Card 3: Focus Music -->
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col justify-between min-h-[220px]">
                <div>
                    <div class="flex items-center gap-2 font-bold text-slate-800 text-xs mb-3">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12 0c0 1.105-1.343 2-3 2s-3-.895-3-2 3 .895 3 2zM9 10l12-3" />
                        </svg>
                        <span>Focus Music</span>
                    </div>

                    <select class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 focus:outline-none mb-3">
                        <option>☁️ Soft Rain</option>
                        <option>🎧 Lo-Fi Beats</option>
                        <option>🌊 White Noise</option>
                    </select>

                    <div class="bg-slate-50 rounded-xl p-3 text-center mb-3 flex items-center justify-center min-h-[50px] border border-slate-100">
                        <div class="flex items-center gap-1 opacity-40">
                            <span class="w-0.5 h-2 bg-blue-600 rounded-full"></span>
                            <span class="w-0.5 h-4 bg-blue-600 rounded-full"></span>
                            <span class="w-0.5 h-1 bg-blue-600 rounded-full"></span>
                            <span class="w-0.5 h-3 bg-blue-600 rounded-full"></span>
                            <span class="w-0.5 h-2 bg-blue-600 rounded-full"></span>
                        </div>
                    </div>
                </div>

                <div class="text-center">
                    <button class="bg-blue-600 hover:bg-blue-700 text-white text-[11px] font-semibold px-5 py-1.5 rounded-lg inline-flex items-center gap-1.5 shadow-2xs">
                        ▶ Play
                    </button>
                    <p class="text-[10px] text-slate-400 mt-1.5">Select a sound and hit play</p>
                </div>
            </div>

            <!-- Card 4: Quick Scratchpad -->
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col justify-between min-h-[220px]">
                <div>
                    <div class="flex items-center gap-2 font-bold text-slate-800 text-xs mb-3">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        <span>Quick Scratchpad</span>
                    </div>

                    <textarea placeholder="Jot down ideas, formulas, or reminders..." 
                              class="w-full bg-slate-50 border border-slate-100 rounded-xl p-3 text-xs text-slate-600 placeholder-slate-300 focus:outline-none h-28 resize-none leading-relaxed"></textarea>
                </div>

                <div class="flex items-center justify-between pt-2">
                    <span class="text-[10px] text-slate-300">Not saved yet</span>
                    <button class="bg-slate-100 hover:bg-slate-200 text-slate-500 text-[11px] font-semibold px-3 py-1.5 rounded-lg transition-colors">
                        Save Notes
                    </button>
                </div>
            </div>

        </main>
    </div>

    <!-- Footer -->
    <footer class="text-center text-[10px] text-slate-400 pt-6">
        Smart Study Hub · Built for focused learners
    </footer>
</div>