            </a>
        </div>

        <!-- Metrics Row -->
        <div class="flex items-center justify-center gap-12 md:gap-20 text-center mb-16 border-t border-b border-slate-100 py-6">
            <div>
                <p class="text-2xl font-extrabold text-slate-900">50K+</p>
                <p class="text-[11px] text-slate-400 font-medium">Active students</p>
            </div>
            <div>
                <p class="text-2xl font-extrabold text-slate-900">2.4M</p>
                <p class="text-[11px] text-slate-400 font-medium">Documents summarized</p>
            </div>
            <div>
                <p class="text-2xl font-extrabold text-slate-900">98%</p>
                <p class="text-[11px] text-slate-400 font-medium">Retention improvement</p>
            </div>
        </div>

        <!-- Browser Mockup Preview Frame -->
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200/80 p-3 max-w-2xl mx-auto">
            <div class="flex items-center gap-1.5 px-2 pb-3 border-b border-slate-100">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                <div class="bg-slate-100 text-[10px] text-slate-400 rounded-md px-3 py-0.5 mx-auto w-3/4 text-center">
                    app.smartstudyhub.io/dashboard
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3 p-4 bg-slate-50/50 rounded-b-xl text-left">
                <div class="bg-white p-3 rounded-lg border border-slate-100 shadow-2xs space-y-2">
                    <p class="text-[11px] font-bold text-slate-700">Document Summarizer</p>
                    <div class="h-2 bg-slate-100 rounded w-3/4"></div>
                    <div class="h-2 bg-slate-100 rounded w-1/2"></div>
                </div>
                <div class="bg-white p-3 rounded-lg border border-slate-100 shadow-2xs space-y-2">
                    <p class="text-[11px] font-bold text-slate-700">Flashcards</p>
                    <div class="h-2 bg-slate-100 rounded w-3/4"></div>
                    <div class="h-2 bg-slate-100 rounded w-1/2"></div>
                </div>
                <div class="bg-white p-3 rounded-lg border border-slate-100 shadow-2xs space-y-2">
                    <p class="text-[11px] font-bold text-slate-700">Focus Music</p>
                    <div class="h-2 bg-slate-100 rounded w-3/4"></div>
                    <div class="h-2 bg-slate-100 rounded w-1/2"></div>
                </div>
                <div class="bg-white p-3 rounded-lg border border-slate-100 shadow-2xs space-y-2">
                    <p class="text-[11px] font-bold text-slate-700">Scratchpad</p>
                    <div class="h-2 bg-slate-100 rounded w-3/4"></div>
                    <div class="h-2 bg-slate-100 rounded w-1/2"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Feature Grid Section -->
    <section class="max-w-5xl mx-auto px-6 py-12">
        <div class="text-center mb-10">
            <h2 class="text-2xl font-bold text-slate-900">Everything you need to focus</h2>
            <p class="text-xs text-slate-400 mt-1">Four tools, one workspace. No juggling tabs.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-2xs space-y-3">
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-sm font-bold">📄</div>
                <h3 class="text-xs font-bold text-slate-900">AI Document Summarizer</h3>
                <p class="text-[11px] text-slate-400 leading-relaxed">Upload any PDF or DOCX and get a crisp, structured summary in seconds.</p>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-2xs space-y-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm font-bold">🎴</div>
                <h3 class="text-xs font-bold text-slate-900">Smart Flashcards</h3>
                <p class="text-[11px] text-slate-400 leading-relaxed">Flip through concept cards built for active recall and spaced repetition.</p>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-2xs space-y-3">
                <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-sm font-bold">🎵</div>
                <h3 class="text-xs font-bold text-slate-900">Focus Music Player</h3>
                <p class="text-[11px] text-slate-400 leading-relaxed">Ambient sounds curated for deep focus — rain, lo-fi, forest, and more.</p>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-2xs space-y-3">
                <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-sm font-bold">📝</div>
                <h3 class="text-xs font-bold text-slate-900">Quick Scratchpad</h3>
                <p class="text-[11px] text-slate-400 leading-relaxed">Capture ideas instantly with a minimal notepad that saves on demand.</p>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-4xl mx-auto px-6 py-8 w-full">
        <div class="bg-blue-600 rounded-2xl p-10 text-center text-white shadow-lg space-y-4">
            <h2 class="text-xl md:text-2xl font-bold">Ready to level up your study sessions?</h2>
            <p class="text-xs text-blue-100">Join 50,000+ students who study smarter every day.</p>
            <div>
                <a href="/login" class="bg-white text-blue-600 hover:bg-blue-50 text-xs font-semibold px-6 py-2.5 rounded-lg inline-flex items-center gap-1.5 shadow-sm transition-colors">
                    Create your free account <span>→</span>
                </a>
            </div>
        </div>
    </section>

    <footer class="text-center py-6 text-[11px] text-slate-400">
        © 2026 Smart Study Hub · Built for focused learners
    </footer>
</div>
