@page "/"

<div class="min-h-screen bg-slate-50/50 text-slate-900 font-sans flex flex-col justify-between">
    <!-- Top Navigation Bar -->
    <header class="max-w-7xl mx-auto w-full px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-sm shadow-sm">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M4 4h4v4H4V4zm6 0h4v4h-4V4zm6 0h4v4h-4V4zM4 10h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4zM4 16h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4z"/>
                </svg>
            </div>
            <span class="font-bold text-base text-slate-900">Smart Study Hub</span>
        </div>
        <div class="flex items-center gap-4 text-xs font-semibold">
            <a href="/login" class="text-slate-600 hover:text-slate-900">Log in</a>
            <a href="/login" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors shadow-sm">Get started</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="max-w-4xl mx-auto text-center px-6 pt-10 pb-12">
        <div class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-600 text-[11px] font-semibold px-3 py-1 rounded-full mb-6 border border-blue-100/50">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Free during beta · No credit card needed
        </div>

        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
            Study smarter, <br/><span class="text-blue-600">not harder.</span>
        </h1>

        <p class="text-sm md:text-base text-slate-500 max-w-xl mx-auto mb-8 leading-relaxed">
            Smart Study Hub brings AI summaries, flashcards, ambient focus music, and quick notes into one clean workspace.
        </p>

        <div class="flex items-center justify-center gap-3 mb-12">
            <a href="/login" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-5 py-2.5 rounded-lg shadow-sm flex items-center gap-2 transition-colors">
                Start studying free <span>→</span>
            </a>
            <a href="/dashboard" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-xs font-semibold px-5 py-2.5 rounded-lg shadow-sm transition-colors">
